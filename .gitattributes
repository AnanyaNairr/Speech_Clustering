# GitHub Linguist Language Configuration
# Ensures Python is detected as the primary/dominant language (99-100%) on GitHub

# Exclude all frontend UI assets (HTML, CSS, JavaScript) from GitHub language statistics
# The files remain 100% active, fully functional, and served by the application,
# but Linguist will not count them against Python in the repository language bar.
frontend/** linguist-vendored=true
frontend/js/** linguist-vendored=true
frontend/css/** linguist-vendored=true
frontend/index.html linguist-documentation=true
*.min.js linguist-vendored=true
*.js linguist-detectable=false
*.html linguist-detectable=false
*.css linguist-detectable=false

# Exclude any Jupyter Notebooks from language statistics completely
*.ipynb linguist-detectable=false
*.ipynb linguist-documentation=true

# Mark datasets, caches, documents, and output reports as documentation/vendored
data/** linguist-documentation=true
outputs/** linguist-documentation=true
docs/** linguist-documentation=true
*.csv linguist-documentation=true
*.joblib linguist-vendored=true
*.pdf linguist-documentation=true
*.json linguist-documentation=true

# Explicitly prioritize all Python code as the primary language
*.py linguist-detectable=true
backend/*.py linguist-detectable=true
run_analysis.py linguist-detectable=true
run_server.py linguist-detectable=true
run_pipeline.py linguist-detectable=true
